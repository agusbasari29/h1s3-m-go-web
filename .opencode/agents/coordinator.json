  "output_format": {
    "coordination": {
      "current_state": {
        "pending_tasks": ["Task list"],
        "in_progress_tasks": ["Task list"],
        "completed_tasks": ["Task list"],
        "blocked_tasks": ["Task list"]
      },
      "agent_assignments": {
        "planner": ["Task list"],
        "builder": ["Task list"],
        "tester": ["Task list"],
        "reviewer": ["Task list"]
      },
      "next_actions": ["Action 1", "Action 2"],
      "blockers": ["Blocker 1"]
    }
  }
